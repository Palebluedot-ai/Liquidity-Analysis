# 复制为 .env 后填入飞书 / Lark 开发者后台的应用凭证
# cp .env.example .env

# 开发者后台 > 凭证与基础信息
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=

# 国内飞书用 https://open.feishu.cn ；国际版 Lark 用 https://open.larksuite.com
LARK_DOMAIN=https://open.feishu.cn

# 日志级别: DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO

# Optional persistent event deduplication directory; defaults to .runtime/lark in the project.
# LARK_STATE_DIR=/path/to/persistent/lark-state
